<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="?android:attr/colorBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Top Header with Back Button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <ImageView
                android:id="@+id/settingsBackBtn"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="8dp"
                android:src="@drawable/ic_go_back"
                app:tint="?android:attr/textColorPrimary"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Go Back"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginEnd="8dp"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Settings"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="?android:attr/textColorPrimary"/>
        </LinearLayout>

        <!-- 1. Appearance Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Appearance"
            android:textColor="@color/colorAccent"
            android:textStyle="bold"
            android:textSize="14sp"
            android:layout_marginBottom="8dp"/>

        <RadioGroup
            android:id="@+id/themeRadioGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp">

            <RadioButton
                android:id="@+id/radioSystem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="System Default"
                android:textColor="?android:attr/textColorPrimary"
                android:minHeight="48dp"/>

            <RadioButton
                android:id="@+id/radioLight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Light Theme"
                android:textColor="?android:attr/textColorPrimary"
                android:minHeight="48dp"/>

            <RadioButton
                android:id="@+id/radioDark"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Dark Theme"
                android:textColor="?android:attr/textColorPrimary"
                android:minHeight="48dp"/>
        </RadioGroup>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?android:attr/listDivider"
            android:layout_marginBottom="16dp"/>

        <!-- 2. Text Size Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Text Size"
            android:textColor="@color/colorAccent"
            android:textStyle="bold"
            android:textSize="14sp"
            android:layout_marginBottom="8dp"/>

        <RadioGroup
            android:id="@+id/textSizeRadioGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp">

            <RadioButton
                android:id="@+id/radioTextSmall"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Small"
                android:textColor="?android:attr/textColorPrimary"
                android:minHeight="48dp"/>

            <RadioButton
                android:id="@+id/radioTextMedium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Medium (Default)"
                android:textColor="?android:attr/textColorPrimary"
                android:minHeight="48dp"/>

            <RadioButton
                android:id="@+id/radioTextLarge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Large"
                android:textColor="?android:attr/textColorPrimary"
                android:minHeight="48dp"/>

            <RadioButton
                android:id="@+id/radioTextExtraLarge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Extra Large"
                android:textColor="?android:attr/textColorPrimary"
                android:minHeight="48dp"/>
        </RadioGroup>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?android:attr/listDivider"
            android:layout_marginBottom="16dp"/>

        <!-- 3. Notifications Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Notifications"
            android:textColor="@color/colorAccent"
            android:textStyle="bold"
            android:textSize="14sp"
            android:layout_marginBottom="8dp"/>

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchJobAlerts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Job Alerts"
            android:textColor="?android:attr/textColorPrimary"
            android:layout_marginBottom="8dp"
            android:minHeight="48dp"/>

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchRecommended"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Recommended Jobs"
            android:textColor="?android:attr/textColorPrimary"
            android:layout_marginBottom="8dp"
            android:minHeight="48dp"/>

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchProfileReminders"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Profile Reminders"
            android:textColor="?android:attr/textColorPrimary"
            android:layout_marginBottom="8dp"
            android:minHeight="48dp"/>

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchAppUpdates"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Application Updates"
            android:textColor="?android:attr/textColorPrimary"
            android:layout_marginBottom="16dp"
            android:minHeight="48dp"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?android:attr/listDivider"
            android:layout_marginBottom="16dp"/>

        <!-- 4. Job Preferences Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Job Preferences"
            android:textColor="@color/colorAccent"
            android:textStyle="bold"
            android:textSize="14sp"
            android:layout_marginBottom="8dp"/>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Work Type"
            android:layout_marginBottom="12dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editWorkType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Full Time, Remote"
                android:textColor="?android:attr/textColorPrimary"
                android:inputType="text" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Preferred Location"
            android:layout_marginBottom="12dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editLocation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Remote / Any"
                android:textColor="?android:attr/textColorPrimary"
                android:inputType="text" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Experience Level"
            android:layout_marginBottom="12dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editExperienceLevel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="1-3 Years"
                android:textColor="?android:attr/textColorPrimary"
                android:inputType="text" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Preferred Skills"
            android:layout_marginBottom="20dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editSkills"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Android, Kotlin, Java, React"
                android:textColor="?android:attr/textColorPrimary"
                android:inputType="text" />
        </com.google.android.material.textfield.TextInputLayout>

        <Button
            android:id="@+id/btnSavePreferences"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Save Job Preferences"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:backgroundTint="@color/colorAccent"
            android:layout_marginBottom="20dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?android:attr/listDivider"
            android:layout_marginBottom="16dp"/>

        <!-- Account / Logout Section -->
        <Button
            android:id="@+id/settingsLogoutBtn"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Log Out"
            android:backgroundTint="@android:color/holo_red_dark"
            android:textColor="#FFFFFF"
            android:textStyle="bold"/>

    </LinearLayout>
</ScrollView>
