<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="?android:attr/colorBackground">

    <!-- Search Input -->
    <EditText
        android:id="@+id/jobsSearchInput"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="Search jobs, skills, location..."
        android:paddingHorizontal="12dp"
        android:background="@drawable/bg_input_field"
        android:textColor="?android:attr/textColorPrimary"
        android:textColorHint="?android:attr/textColorSecondary"
        android:textSize="14sp"
        android:layout_marginBottom="8dp"/>

    <!-- Filter & Sort Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp"
        android:gravity="center_vertical">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/filterBtn"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="Filter"
            android:textSize="12sp"
            app:icon="@drawable/ic_filter_list"
            app:iconSize="18dp"
            app:cornerRadius="8dp"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/sortBtn"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="Sort: Latest"
            android:textSize="12sp"
            app:icon="@drawable/ic_sort"
            app:iconSize="18dp"
            app:cornerRadius="8dp"
            android:layout_marginStart="8dp"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1"/>

        <TextView
            android:id="@+id/activeFiltersCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="12sp"
            android:textColor="@color/colorAccent"
            android:textStyle="bold"/>
    </LinearLayout>

    <!-- Active Filter Chips Row -->
    <HorizontalScrollView
        android:id="@+id/activeFiltersScrollView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:visibility="gone"
        android:layout_marginBottom="8dp">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/activeFiltersChipGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleLine="true"/>
    </HorizontalScrollView>

    <!-- Swipe Refresh & List / Empty Area -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/jobsSwipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/jobsRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>

            <ProgressBar
                android:id="@+id/jobsProgressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="gone"/>

            <!-- Polished Empty Filter Results State -->
            <LinearLayout
                android:id="@+id/emptyStateContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="24dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:src="@drawable/ic_search_off"
                    app:tint="?android:attr/textColorSecondary"
                    android:contentDescription="No jobs found"/>

                <TextView
                    android:id="@+id/jobsEmptyTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="No jobs found"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="?android:attr/textColorPrimary"
                    android:layout_marginTop="12dp"/>

                <TextView
                    android:id="@+id/jobsEmptyView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Try removing some filters or changing your search."
                    android:textSize="13sp"
                    android:textColor="?android:attr/textColorSecondary"
                    android:gravity="center"
                    android:layout_marginTop="4dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/clearFiltersEmptyBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="Clear Filters"
                    android:textSize="12sp"
                    android:layout_marginTop="16dp"
                    app:cornerRadius="8dp"/>
            </LinearLayout>

        </FrameLayout>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</LinearLayout>
