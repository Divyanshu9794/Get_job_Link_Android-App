<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/profileSwipeRefresh"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:background="?android:attr/colorBackground">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:paddingBottom="32dp">

            <!-- 1. Profile Header Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="1dp"
                app:cardBackgroundColor="@color/cardBackground"
                app:strokeWidth="1dp"
                app:strokeColor="@color/cardStrokeColor">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:gravity="center_horizontal">

                    <ImageView
                        android:id="@+id/profileAvatar"
                        android:layout_width="84dp"
                        android:layout_height="84dp"
                        android:src="@drawable/ic_profile"
                        android:scaleType="centerCrop"
                        android:background="@drawable/bg_circle"
                        android:contentDescription="Profile Photo"
                        android:clickable="true"
                        android:focusable="true"/>

                    <TextView
                        android:id="@+id/profileName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Divyanshu Singh"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="?android:attr/textColorPrimary"
                        android:layout_marginTop="12dp"/>

                    <TextView
                        android:id="@+id/profileHeadline"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Software Engineer | React | Node.js"
                        android:textSize="14sp"
                        android:textColor="@color/colorAccent"
                        android:textAlignment="center"
                        android:layout_marginTop="4dp"/>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="6dp">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_location"
                            app:tint="@color/colorAccent"
                            android:contentDescription="Location Icon"/>

                        <TextView
                            android:id="@+id/profileLocation"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Prayagraj, Uttar Pradesh"
                            android:textSize="13sp"
                            android:textColor="?android:attr/textColorSecondary"
                            android:layout_marginStart="4dp"/>
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/editProfileMainBtn"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Edit Profile"
                        android:textSize="13sp"
                        app:icon="@drawable/ic_edit"
                        app:iconSize="16dp"
                        app:cornerRadius="8dp"
                        android:layout_marginTop="16dp"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 2. Profile Completion Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="1dp"
                app:cardBackgroundColor="@color/cardBackground"
                app:strokeWidth="1dp"
                app:strokeColor="@color/cardStrokeColor">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Profile Completion"
                            android:textStyle="bold"
                            android:textSize="15sp"
                            android:textColor="?android:attr/textColorPrimary"/>

                        <TextView
                            android:id="@+id/completionPercentText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="82%"
                            android:textStyle="bold"
                            android:textSize="15sp"
                            android:textColor="@color/colorAccent"/>
                    </LinearLayout>

                    <ProgressBar
                        android:id="@+id/completionProgressBar"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="8dp"
                        android:progress="82"
                        android:progressDrawable="@drawable/bg_pill_accent"
                        android:layout_marginTop="10dp"/>

                    <TextView
                        android:id="@+id/completionAdviceText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="You're almost there. Complete your profile to improve personalized job matching."
                        android:textSize="12sp"
                        android:textColor="?android:attr/textColorSecondary"
                        android:layout_marginTop="8dp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 3. Open to Work Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="1dp"
                app:cardBackgroundColor="@color/cardBackground"
                app:strokeWidth="1dp"
                app:strokeColor="@color/cardStrokeColor">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_work_history"
                        app:tint="@color/colorAccent"
                        android:contentDescription="Work Icon"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="8dp">

                        <TextView
                            android:id="@+id/openToWorkStatusText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Open to Work"
                            android:textStyle="bold"
                            android:textSize="15sp"
                            android:textColor="?android:attr/textColorPrimary"/>

                        <TextView
                            android:id="@+id/openToWorkDescText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Available for new opportunities"
                            android:textSize="12sp"
                            android:textColor="?android:attr/textColorSecondary"
                            android:layout_marginTop="2dp"/>
                    </LinearLayout>

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/openToWorkSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        app:useMaterialThemeColors="true"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 4. About Section -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="1dp"
                app:cardBackgroundColor="@color/cardBackground"
                app:strokeWidth="1dp"
                app:strokeColor="@color/cardStrokeColor">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="About"
                            android:textStyle="bold"
                            android:textSize="15sp"
                            android:textColor="?android:attr/textColorPrimary"/>

                        <TextView
                            android:id="@+id/editAboutBtn"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:text="Edit"
                            android:textColor="@color/colorAccent"
                            android:textStyle="bold"
                            android:textSize="13sp"
                            android:background="?android:attr/selectableItemBackground"
                            android:paddingHorizontal="4dp"/>
                    </RelativeLayout>

                    <TextView
                        android:id="@+id/aboutContentText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Passionate software engineer with experience building full-stack applications using React, Node.js, and Android."
                        android:textSize="13sp"
                        android:textColor="?android:attr/textColorSecondary"
                        android:layout_marginTop="8dp"
                        android:lineSpacingExtra="2dp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 5. Experience Section -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="1dp"
                app:cardBackgroundColor="@color/cardBackground"
                app:strokeWidth="1dp"
                app:strokeColor="@color/cardStrokeColor">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Experience"
                            android:textStyle="bold"
                            android:textSize="15sp"
                            android:textColor="?android:attr/textColorPrimary"/>

                        <TextView
                            android:id="@+id/addExperienceBtn"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:text="+ Add"
                            android:textColor="@color/colorAccent"
                            android:textStyle="bold"
                            android:textSize="13sp"
                            android:background="?android:attr/selectableItemBackground"
                            android:paddingHorizontal="4dp"/>
                    </RelativeLayout>

                    <LinearLayout
                        android:id="@+id/experienceContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 6. Education Section -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="1dp"
                app:cardBackgroundColor="@color/cardBackground"
                app:strokeWidth="1dp"
                app:strokeColor="@color/cardStrokeColor">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Education"
                            android:textStyle="bold"
                            android:textSize="15sp"
                            android:textColor="?android:attr/textColorPrimary"/>

                        <TextView
                            android:id="@+id/addEducationBtn"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:text="+ Add"
                            android:textColor="@color/colorAccent"
                            android:textStyle="bold"
                            android:textSize="13sp"
                            android:background="?android:attr/selectableItemBackground"
                            android:paddingHorizontal="4dp"/>
                    </RelativeLayout>

                    <LinearLayout
                        android:id="@+id/educationContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 7. Skills Section -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="1dp"
                app:cardBackgroundColor="@color/cardBackground"
                app:strokeWidth="1dp"
                app:strokeColor="@color/cardStrokeColor">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Skills"
                            android:textStyle="bold"
                            android:textSize="15sp"
                            android:textColor="?android:attr/textColorPrimary"/>

                        <TextView
                            android:id="@+id/addSkillBtn"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:text="+ Add"
                            android:textColor="@color/colorAccent"
                            android:textStyle="bold"
                            android:textSize="13sp"
                            android:background="?android:attr/selectableItemBackground"
                            android:paddingHorizontal="4dp"/>
                    </RelativeLayout>

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/skillsChipGroup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:chipSpacingHorizontal="6dp"
                        app:chipSpacingVertical="4dp"/>

                    <TextView
                        android:id="@+id/emptySkillsText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="No skills added yet."
                        android:textSize="13sp"
                        android:textColor="?android:attr/textColorSecondary"
                        android:visibility="gone"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 8. Resume Section -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="1dp"
                app:cardBackgroundColor="@color/cardBackground"
                app:strokeWidth="1dp"
                app:strokeColor="@color/cardStrokeColor">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Resume"
                        android:textStyle="bold"
                        android:textSize="15sp"
                        android:textColor="?android:attr/textColorPrimary"/>

                    <!-- Container when resume exists -->
                    <LinearLayout
                        android:id="@+id/resumeUploadedContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="10dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <ImageView
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:src="@drawable/ic_description"
                                app:tint="@color/colorAccent"
                                android:contentDescription="Resume Document Icon"/>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:layout_marginStart="10dp">

                                <TextView
                                    android:id="@+id/resumeFileNameText"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Divyanshu_Singh_Resume.pdf"
                                    android:textSize="13sp"
                                    android:textStyle="bold"
                                    android:singleLine="true"
                                    android:maxLines="1"
                                    android:ellipsize="end"
                                    android:textColor="?android:attr/textColorPrimary"/>

                                <TextView
                                    android:id="@+id/resumeUpdatedText"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Updated Today"
                                    android:textSize="11sp"
                                    android:textColor="?android:attr/textColorSecondary"
                                    android:layout_marginTop="2dp"/>
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Equal-Width Non-Wrapping Action Buttons Row -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="12dp">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/previewResumeBtn"
                                android:layout_width="0dp"
                                android:layout_height="40dp"
                                android:layout_weight="1"
                                android:text="View"
                                android:textSize="12sp"
                                android:singleLine="true"
                                android:maxLines="1"
                                app:autoSizeTextType="uniform"
                                app:autoSizeMinTextSize="10sp"
                                app:autoSizeMaxTextSize="12sp"
                                app:icon="@drawable/ic_visibility"
                                app:iconSize="16dp"
                                app:iconPadding="4dp"
                                android:paddingHorizontal="4dp"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                app:cornerRadius="6dp"
                                style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/replaceResumeBtn"
                                android:layout_width="0dp"
                                android:layout_height="40dp"
                                android:layout_weight="1"
                                android:text="Update"
                                android:textSize="12sp"
                                android:singleLine="true"
                                android:maxLines="1"
                                app:autoSizeTextType="uniform"
                                app:autoSizeMinTextSize="10sp"
                                app:autoSizeMaxTextSize="12sp"
                                app:icon="@drawable/ic_upload"
                                app:iconSize="16dp"
                                app:iconPadding="4dp"
                                android:paddingHorizontal="4dp"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:layout_marginStart="6dp"
                                app:cornerRadius="6dp"
                                style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/downloadResumeBtn"
                                android:layout_width="0dp"
                                android:layout_height="40dp"
                                android:layout_weight="1"
                                android:text="Download"
                                android:textSize="12sp"
                                android:singleLine="true"
                                android:maxLines="1"
                                app:autoSizeTextType="uniform"
                                app:autoSizeMinTextSize="10sp"
                                app:autoSizeMaxTextSize="12sp"
                                app:icon="@drawable/ic_download"
                                app:iconSize="16dp"
                                app:iconPadding="4dp"
                                android:paddingHorizontal="4dp"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:layout_marginStart="6dp"
                                app:cornerRadius="6dp"
                                style="@style/Widget.MaterialComponents.Button"/>
                        </LinearLayout>

                        <!-- Compact End-Aligned Delete Action -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/deleteResumeBtn"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:text="Delete Resume"
                            android:textSize="12sp"
                            app:icon="@drawable/ic_delete"
                            app:iconSize="14dp"
                            android:textColor="#EF4444"
                            app:iconTint="#EF4444"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:layout_marginTop="8dp"
                            android:layout_gravity="end"
                            app:cornerRadius="6dp"
                            style="@style/Widget.MaterialComponents.Button.TextButton"/>
                    </LinearLayout>

                    <!-- Container when no resume exists -->
                    <LinearLayout
                        android:id="@+id/resumeEmptyContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center_horizontal"
                        android:paddingVertical="12dp"
                        android:visibility="gone">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@drawable/ic_description"
                            app:tint="@color/colorAccent"
                            android:contentDescription="Document Icon"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="No resume uploaded yet."
                            android:textSize="13sp"
                            android:textColor="?android:attr/textColorSecondary"
                            android:layout_marginTop="6dp"/>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/uploadResumeBtn"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:text="Upload Resume"
                            android:textSize="13sp"
                            app:icon="@drawable/ic_upload"
                            app:iconSize="16dp"
                            android:layout_marginTop="12dp"
                            app:cornerRadius="6dp"/>
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 9. Certifications Section -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="1dp"
                app:cardBackgroundColor="@color/cardBackground"
                app:strokeWidth="1dp"
                app:strokeColor="@color/cardStrokeColor">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Certifications"
                            android:textStyle="bold"
                            android:textSize="15sp"
                            android:textColor="?android:attr/textColorPrimary"/>

                        <TextView
                            android:id="@+id/addCertificationBtn"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:text="+ Add"
                            android:textColor="@color/colorAccent"
                            android:textStyle="bold"
                            android:textSize="13sp"
                            android:background="?android:attr/selectableItemBackground"
                            android:paddingHorizontal="4dp"/>
                    </RelativeLayout>

                    <LinearLayout
                        android:id="@+id/certificationsContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 10. Projects Section -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="1dp"
                app:cardBackgroundColor="@color/cardBackground"
                app:strokeWidth="1dp"
                app:strokeColor="@color/cardStrokeColor">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Projects"
                            android:textStyle="bold"
                            android:textSize="15sp"
                            android:textColor="?android:attr/textColorPrimary"/>

                        <TextView
                            android:id="@+id/addProjectBtn"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:text="+ Add"
                            android:textColor="@color/colorAccent"
                            android:textStyle="bold"
                            android:textSize="13sp"
                            android:background="?android:attr/selectableItemBackground"
                            android:paddingHorizontal="4dp"/>
                    </RelativeLayout>

                    <LinearLayout
                        android:id="@+id/projectsContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 11. Clean Log Out Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/profileLogoutBtn"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Log Out"
                android:textSize="14sp"
                app:icon="@drawable/ic_logout"
                app:iconSize="18dp"
                android:textColor="#EF4444"
                app:iconTint="#EF4444"
                app:strokeColor="#FCA5A5"
                app:strokeWidth="1dp"
                app:cornerRadius="8dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="12dp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>

            <!-- 12. Delete Account Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/profileDeleteAccountBtn"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Delete Account"
                android:textSize="14sp"
                app:icon="@drawable/ic_delete"
                app:iconSize="18dp"
                android:textColor="#DC2626"
                app:iconTint="#DC2626"
                app:strokeColor="#F87171"
                app:strokeWidth="1dp"
                app:cornerRadius="8dp"
                android:layout_marginBottom="24dp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>

        </LinearLayout>
    </ScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
