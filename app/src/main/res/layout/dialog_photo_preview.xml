<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheet"
    android:padding="20dp"
    android:gravity="center_horizontal">

    <!-- Drag Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_chip" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Change Photo"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="?android:attr/textColorPrimary"
        android:textAlignment="center"
        android:layout_marginBottom="16dp"/>

    <!-- Preview Image Container -->
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/imgPhotoPreview"
        android:layout_width="140dp"
        android:layout_height="140dp"
        android:scaleType="centerCrop"
        android:layout_marginBottom="20dp"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
        android:background="@drawable/bg_circle"/>

    <!-- Upload Progress -->
    <LinearLayout
        android:id="@+id/layoutUploadProgress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/txtUploadProgressStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Uploading photo... 0%"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorPrimary"
            android:textAlignment="center"
            android:layout_marginBottom="8dp"/>

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progressUploadPhoto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:indeterminate="false"
            app:trackCornerRadius="4dp"/>
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnConfirmUploadPhoto"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="Upload Photo"
        android:textSize="16sp"
        android:textStyle="bold"
        app:cornerRadius="12dp"
        android:backgroundTint="@color/colorAccent"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="8dp"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCancelUploadPhoto"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="Cancel"
        android:textSize="15sp"
        app:cornerRadius="12dp"
        style="@style/Widget.Material3.Button.TextButton"/>

</LinearLayout>